# Server bind host and HTTP/WebSocket port (defaults to 127.0.0.1:3210)
MYAGENTS_HOST=127.0.0.1
MYAGENTS_PORT=3210

# Initial administrator account credentials (defaults to admin / admin if unset)
MYAGENTS_ADMIN_USER=admin
MYAGENTS_ADMIN_PASS=change-this-password

# Optional custom runtime data directory (defaults to ~/.myagents)
# MYAGENTS_HOME=/path/to/.myagents

# Optional custom daemon socket / Windows named pipe path
# MYAGENTS_DAEMON_ENDPOINT=/tmp/myagents-daemon.sock
