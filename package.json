{
  "name": "my-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:daemon": "pnpm --filter @myagents/daemon run dev",
    "dev:core": "pnpm --filter @myagents/core run dev",
    "dev:web": "pnpm --filter @myagents/web run dev",
    "build": "pnpm --filter @myagents/web run build && pnpm -r run typecheck",
    "start": "node scripts/start.mjs",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
