{
  "name": "my-agents",
  "version": "0.1.0",
  "description": "Server-side multi-agent orchestration middleware and React web workbench powered by TypeScript, Node.js 22 node:sqlite, Fastify, and a detached daemon.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lilojmmJimmy/omagents.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:daemon": "pnpm --filter @myagents/daemon run dev",
    "dev:core": "pnpm --filter @myagents/core run dev",
    "dev:web": "pnpm --filter @myagents/web run dev",
    "build": "pnpm --filter @myagents/web run build && pnpm -r run typecheck",
    "start": "node scripts/start.mjs",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
